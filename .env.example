# Steam4Caster backend configuration. Copy to `.env` and fill in real values.
# Never commit `.env`. Only configuration for features you enable is required.

# --- Application -----------------------------------------------------------
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true
# Comma-separated explicit origin allowlist for the separate frontend. Never "*".
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Used to build email verification links.
FRONTEND_BASE_URL=http://localhost:3000

# --- Storage ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://steam4caster:steam4caster@localhost:55432/steam4caster
REDIS_URL=redis://localhost:6379/0

# Run background jobs inside the API process instead of a Celery worker. For
# single-process setups only (start.bat uses it when Docker is not running).
INLINE_JOBS=false

# --- Authentication --------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# Encrypts stored push-subscription secrets. Required in production; any long random string.
SECRETS_ENCRYPTION_KEY=
REQUIRE_VERIFIED_EMAIL_FOR_ALERTS=false

# --- Price data provider (IsThereAnyDeal) ----------------------------------
# `itad` uses the real API and needs ITAD_API_KEY (https://isthereanydeal.com/apps/my/).
# `fake` is an explicit synthetic demo dataset for local development only.
PRICE_PROVIDER=itad
ITAD_API_KEY=
ITAD_BASE_URL=https://api.isthereanydeal.com
# Identify your deployment to the provider (include a contact URL or email).
PROVIDER_USER_AGENT=Steam4Caster/0.1 (+https://your-domain.example; contact@your-domain.example)
DEFAULT_COUNTRY=IN
DEFAULT_CURRENCY=INR

# --- Forecasting -----------------------------------------------------------
MODEL_ARTIFACT_PATH=./artifacts
# Optional: pin inference to one registered model version instead of the ACTIVE one.
ACTIVE_MODEL_VERSION=
ML_ENABLED=true
# Weekly candidate training. Never activates a model automatically.
TRAINING_SCHEDULE_ENABLED=false

# --- Web Push (primary free channel) ---------------------------------------
# Generate with: python -m app.cli generate-vapid-keys   (set all three or none)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Email -----------------------------------------------------------------
# smtp | resend | none
EMAIL_PROVIDER=smtp
EMAIL_FROM=Steam4Caster <alerts@localhost>
# Required only when EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Mailpit in local development
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false

# --- SMS (optional, paid, off by default) ----------------------------------
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
